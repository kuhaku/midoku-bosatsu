{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "未読菩薩",
  "version": "0.1.3",
  "identifier": "com.github.midokubosatsu",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "未読菩薩",
        "width": 1100,
        "height": 800,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERGNDIwRUJBQTdEM0M0NkUKUldSdXhOT251ZzVDMzhESUYvcWt1VDRVcFlRQ0N6aUpzWmZyTllZMGhuQzVpZVRGYW9vRy9PaFgK",
      "endpoints": [
        "https://github.com/kuhaku/midoku-bosatsu/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/global.toml",
      "resources/bbs.toml",
      "resources/reader-style.css",
      "resources/notify.ogg",
      "resources/notify.wav"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
